digraph card {
  graph [rankdir=TB, fontname="PlemolJP35", fontsize=13, nodesep=0.26, ranksep=0.50, pad=0.18, ordering=out];
  node [fontname="PlemolJP35", fontsize=11, shape=box, style="solid,rounded", margin="0.12,0.07"];
  edge [fontname="PlemolJP35", fontsize=9, style=solid, arrowhead=vee];

  K1 [label="1 カードを書く\nTASKS.md に書く"];
  K2 [label="2 曖昧さの検査\n読み取り専用のワーカー"];
  K3 [label="3 配る\nワークツリーを作る"];
  K4 [label="4 実装する\nDSH ワーカー"];
  K5 [label="5 差分をレビュー\nリード"];
  K6 [label="6 二つ目のレビュー\ngpt-6.1-sol"];
  K7 [label="7 ゲート\nmake check"];
  K8 [label="8 land と Status: done\nskk-manager の許可"];

  { rank=same; K1; K2; K3; K4; }
  { rank=same; K5; K6; K7; K8; }

  K1 -> K2;
  K2 -> K3;
  K3 -> K4;
  K1 -> K5 [style=invis, weight=20];
  K4 -> K5;
  K5 -> K6;
  K6 -> K7;
  K7 -> K8;
}
